    <string name="credits_group_tools">Running and shipping</string>
    <string name="credits_lewewe">Maintains the Enhanced fork for HyperOS 4, improving artwork, lyrics, status icons, notification gestures, AOD, and player customization.</string>
    <string name="credits_puhboo">Contributed online lyric translation with LibreTranslate, Google Cloud and DeepL, Extended lyric search with title and artist aliases, Spicy Lyrics support and provider caching. Also contributed parsing and word-timing improvements, native translation and romanisation integration, and optional Alive lyrics effects, including the Eye-Candy pause fix.</string>
    <string name="credits_hypernavbar">The whole UI scaffolding: theme, floating and liquid-glass navigation bars, background blur, the about page and the locale helper</string>
    <string name="credits_miuix">Every component this interface is built from</string>
    <string name="credits_liquid_glass">The lens, the inner shadow and the vibrancy behind the liquid glass</string>
    <string name="credits_markdown_css">How the release notes are typeset</string>
    <string name="credits_cialloum">The square cover card, the morph between the thumbnail and the cover, and the lock screen lyric position, size and weight settings</string>
    <string name="credits_hyperchanger">The lock screen super island (ported by btm_m), and lifting the depth, saved-lock-screen, clock colon and global-theme glass restrictions</string>
    <string name="credits_leaf">Video and depth video wallpaper support</string>
    <string name="credits_hypertweak">Hiding the lock screen\'s fingerprint print and its animation</string>
    <string name="credits_amll">How the lock screen lyrics move</string>
    <string name="credits_amll_db">Where the word-by-word lyrics come from</string>
    <string name="credits_accompanist">Parses TTML, LRC, YRC and KRC lyrics</string>
    <string name="credits_lyricinfo">One of the places player lyrics come from</string>
    <string name="credits_hle">QQ Music, Kuwo and TTML Hub lyrics, and the song matching rules</string>
    <string name="credits_lsposed">The framework this module runs in</string>
    <string name="credits_installerx">Handing an update to an installer app, hiding the icon, and the dial code</string>
